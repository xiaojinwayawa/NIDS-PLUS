# API Settings
API_V1_PREFIX=/api
PROJECT_NAME=NIDS System

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nids
MYSQL_PASSWORD=nids_password
MYSQL_DATABASE=nids_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Traffic Capture
TRAFFIC_SOURCE_MODE=pcap
PCAP_FILE_PATH=./data/pcaps/sample.pcap
NETWORK_INTERFACE=eth0

# Detection Engine
BATCH_SIZE=100
INFERENCE_INTERVAL_MS=50
ALERT_THRESHOLD=0.8
MAX_QUEUE_SIZE=10000

# Features
ENABLE_SHAP=true

# Logging
LOG_LEVEL=INFO
